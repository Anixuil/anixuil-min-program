# 变量必须以 VITE_ 为前缀才能暴露给外部读取

# 项目运行的端口号
VITE_APP_PORT = 5173

# API 基础路径，开发环境下的请求前缀
VITE_APP_BASE_API = '/ani-server'

# API 服务器的 URL
# VITE_APP_API_URL = 'https://api.anixuil.com'
VITE_APP_API_URL = 'http://localhost:3000'

# 小程序开发环境请求地址（不包含 /ani-server 前缀）
VITE_BADMINTON_ORIGIN=http://127.0.0.1:3000

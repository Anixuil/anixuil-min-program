{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^my-(.*)": "@/components/$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(.*)": "@/components/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "羽球对决"
      }
    },
    {
      "path": "pages/schedule/index",
      "style": {
        "navigationBarTitleText": "赛程-羽球对决"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的-羽球对决",
        "renderer": "skyline",
        "componentFramework": "glass-easel",
        "navigationStyle": "custom",
        "disableScroll": true
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录-羽球对决"
      }
    },
    {
      "path": "pages/profile/complete-info",
      "style": {
        "navigationBarTitleText": "补充信息-羽球对决"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "羽球对决",
    "navigationBarBackgroundColor": "#1E293B",
    "backgroundColor": "#1E293B"
  },
  "tabBar": {
    "color": "#8C8C8C",
    "selectedColor": "#00FF94",
    "backgroundColor": "#1E293B",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/schedule/index",
        "text": "赛程",
        "iconPath": "static/tabbar/history.png",
        "selectedIconPath": "static/tabbar/history-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  }
}

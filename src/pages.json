{
  "easycom": { "autoscan": true, "custom": { "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue" } },
  "pages": [
    { "path": "pages/index/index", "style": {
      // #ifdef MP-WEIXIN
      "navigationStyle": "custom",
      // #endif
      "navigationBarTitleText": "一羽成局", "enablePullDownRefresh": true
    } },
    { "path": "pages/schedule/index", "style": {
      // #ifdef MP-WEIXIN
      "navigationStyle": "custom",
      // #endif
      "navigationBarTitleText": "我的球局", "enablePullDownRefresh": true
    } },
    { "path": "pages/profile/index", "style": { "navigationBarTitleText": "我的羽球" } },
    { "path": "pages/profile/email", "style": { "navigationBarTitleText": "邮箱与密码" } },
    { "path": "pages/points/index", "style": { "navigationBarTitleText": "积分中心", "enablePullDownRefresh": true } },
    { "path": "pages/messages/index", "style": { "navigationBarTitleText": "消息中心", "enablePullDownRefresh": true } },
    { "path": "pages/create/index", "style": { "navigationBarTitleText": "发起球局" } },
    { "path": "pages/matchDetails/index", "style": { "navigationBarTitleText": "球局详情", "enablePullDownRefresh": true } },
    { "path": "pages/matchResults/index", "style": { "navigationBarTitleText": "球局战绩", "enablePullDownRefresh": true } },
    { "path": "pages/login/index", "style": { "navigationBarTitleText": "登录" } },
    { "path": "pages/register/index", "style": { "navigationBarTitleText": "注册" } },
    { "path": "pages/scheduleDetails/index", "style": { "navigationBarTitleText": "球局详情" } },
    { "path": "pages/profile/complete-info", "style": { "navigationBarTitleText": "个人资料" } }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black", "navigationBarBackgroundColor": "#f4f5f2", "backgroundColor": "#f4f5f2"
  },
  "tabBar": {
    "color": "#65716a", "selectedColor": "#e96b35", "backgroundColor": "#ffffff", "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页", "iconPath": "static/tabbar/home.png", "selectedIconPath": "static/tabbar/home-active.png" },
      { "pagePath": "pages/schedule/index", "text": "球局", "iconPath": "static/tabbar/history.png", "selectedIconPath": "static/tabbar/history-active.png" },
      { "pagePath": "pages/profile/index", "text": "我的", "iconPath": "static/tabbar/profile.png", "selectedIconPath": "static/tabbar/profile-active.png" }
    ]
  }
}


